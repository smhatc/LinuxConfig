// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "Debian",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	// Disable SELinux process confinement for this container to allow read/write
	// access to host workspace files on SELinux-enabled distributions (e.g., openSUSE, Fedora).
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"runArgs": [
		"--security-opt",
		"label=disable",
	],
	// Mount host Hyprland stubs into the container (if present on your host machine)
	"mounts": [
		"source=/usr/share/hypr/stubs,target=/usr/share/hypr/stubs,type=bind,readonly"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code",
				"streetsidesoftware.code-spell-checker",
				"mads-hartmann.bash-ide-vscode",
				"sumneko.lua"
			],
			"settings": {
				"editor.tabSize": 4,
				"editor.formatOnSave": true,
				"[shellscript]": {
					"editor.defaultFormatter": "mads-hartmann.bash-ide-vscode",
				},
				"Lua.workspace.library": [
					"/usr/share/hypr/stubs"
				],
			}
		}
	},
	// Automatically install CLI tools on container creation
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y shellcheck shfmt",
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root",
}