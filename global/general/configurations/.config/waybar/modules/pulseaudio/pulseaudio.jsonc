{
    "pulseaudio#output": {
        "format": "{icon} {volume}%",
        "format-muted": "{icon} {volume}%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"],
            "default-muted": "󰝟",
            "headphone": "󰋋",
            "headphone-muted": "󰟎",
            "headset": "󰋋",
            "headset-muted": "󰟎",
        },
        "min-length": 6,
        "max-length": 6,
        "scroll-step": 0.0,
        "on-scroll-up": "~/.config/waybar/scripts/volume.sh raise-output",
        "on-scroll-down": "~/.config/waybar/scripts/volume.sh lower-output",
        "on-click": "~/.config/waybar/scripts/volume.sh mute-output",
        "on-click-right": "pavucontrol -t 3",
        "cursor": false,
        "tooltip": false,
    },
    "pulseaudio#input": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭 {volume}%",
        "min-length": 6,
        "max-length": 6,
        "scroll-step": 0.0,
        "on-scroll-up": "~/.config/waybar/scripts/volume.sh raise-input",
        "on-scroll-down": "~/.config/waybar/scripts/volume.sh lower-input",
        "on-click": "~/.config/waybar/scripts/volume.sh mute-input",
        "on-click-right": "pavucontrol -t 4",
        "cursor": false,
        "tooltip": false,
    },
}
