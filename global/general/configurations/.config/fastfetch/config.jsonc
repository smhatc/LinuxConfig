{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "padding": {
            "top": 1,
            "left": 4,
        },
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "{#default}╭ 󰍹  Hardware ──────────────────────────────────────────────────────────╮{#}",
        },
        {
            "type": "host",
            "key": "│ Host    ",
            "keyColor": "default",
        },
        {
            "type": "cpu",
            "key": "│ CPU     ",
            "keyColor": "default",
        },
        {
            "type": "gpu",
            "key": "│ GPU     ",
            "keyColor": "default",
            "format": "{name}",
        },
        {
            "type": "memory",
            "key": "│ RAM     ",
            "keyColor": "default",
        },
        {
            "type": "swap",
            "key": "│ Swap    ",
            "keyColor": "default",
        },
        {
            "type": "disk",
            "key": "│ Disk    ",
            "keyColor": "default",
            "format": "{mountpoint:15} - {size-used} / {size-total} ({size-percentage}) - {filesystem}",
        },
        {
            "type": "custom",
            "format": "{#default}╰───────────────────────────────────────────────────────────────────────╯{#}",
        },
        "break",
        {
            "type": "custom",
            "format": "{#default}╭   Software ──────────────────────────────────────────────────────────╮{#}",
        },
        {
            "type": "os",
            "key": "│ OS      ",
            "keyColor": "default",
        },
        {
            "type": "kernel",
            "key": "│ Kernel  ",
            "keyColor": "default",
        },
        {
            "type": "packages",
            "key": "│ Packages",
            "keyColor": "default",
        },
        {
            "type": "shell",
            "key": "│ Shell   ",
            "keyColor": "default",
        },
        {
            "type": "terminal",
            "key": "│ Terminal",
            "keyColor": "default",
        },
        {
            "type": "wm",
            "key": "│ WM      ",
            "keyColor": "default",
        },
        {
            "type": "de",
            "key": "│ DE      ",
            "keyColor": "default",
        },
        {
            "type": "custom",
            "format": "{#default}╰───────────────────────────────────────────────────────────────────────╯{#}",
        },
        "break",
        {
            "type": "custom",
            "format": "{#default}╭   OS Stats ──────────────────────────────────────────────────────────╮{#}",
        },
        {
            "type": "uptime",
            "key": "│ Uptime  ",
            "keyColor": "default",
        },
        {
            "type": "command",
            "key": "│ Age     ",
            "keyColor": "default",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
        },
        {
            "type": "custom",
            "format": "{#default}╰───────────────────────────────────────────────────────────────────────╯{#}",
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle",
        },
    ],
}
